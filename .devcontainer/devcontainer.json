{
  "name": "RMS MRI import",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt -r requirements-dev.txt",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "App", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] }
  }
}
